<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>
    <h2>Edit details of CampGround!</h2>
    <form action="/campgrounds/<%= campground._id%>?_method=put" method="post">
        <label for="title">Enter camp name</label>
        <input type="text" id="title" name="title" value="<%= campground.title%>">

        <label for="location">Enter location</label>
        <input type="text" id="location" name="location" value="<%= campground.location %>">
        <br>
        <button>Save Campground</button>
    </form>
    <footer>
        <a href="/campgrounds/<%= campground._id  %>">back</a>
    </footer>
</body>

</html>